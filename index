    "block_title": "OPE Consolidación 2022 - Parte B (Opción 2)",
    "block_subtitle": "Supuestos Prácticos: Notificaciones, Plazos y Lenguas"
  }
];

        // Algoritmo de barajado Fisher-Yates (Inmutable)
        function shuffleArray(array) {
            const arr = [...array];
            for (let i = arr.length - 1; i > 0; i--) {
                const j = Math.floor(Math.random() * (i + 1));
                [arr[i], arr[j]] = [arr[j], arr[i]];
            }
            return arr;
        }

        // Recuperaci├│n s├¡ncrona del progreso guardado en localStorage
        const savedProgress = (() => {
            try {
                const saved = localStorage.getItem(PROGRESS_KEY);
                return saved ? JSON.parse(saved) : null;
            } catch (e) {
                console.error("Error al leer localStorage", e);
                return null;
            }
        })();

        function App() {
            // Inicializaci├│n de estados diferida (Lazy State Initialization)
            const [view, setView] = useState(() => savedProgress?.view || 'menu');
            const [currentBlockTitle, setCurrentBlockTitle] = useState(() => savedProgress?.currentBlockTitle || '');
            const [questionsQueue, setQuestionsQueue] = useState(() => savedProgress?.questionsQueue || []);
            const [failedQueue, setFailedQueue] = useState(() => savedProgress?.failedQueue || []);
            const [currentIndex, setCurrentIndex] = useState(() => savedProgress?.currentIndex ?? 0);
            const [stats, setStats] = useState(() => savedProgress?.stats || { answered: 0, correct: 0, failed: 0 });
            const [isReviewing, setIsReviewing] = useState(() => savedProgress?.isReviewing || false);
            const [selectedId, setSelectedId] = useState(() => savedProgress?.selectedId ?? null);
            const [hasAnsweredCurrent, setHasAnsweredCurrent] = useState(() => savedProgress?.hasAnsweredCurrent || false);

            // Persistencia del estado mediante un ├║nico efecto secundario reactivo
            useEffect(() => {
                if (view === 'quiz') {
                    const stateToSave = {
                        view,
                        currentBlockTitle,
                        questionsQueue,
                        failedQueue,
                        currentIndex,
                        stats,
                        isReviewing,
                        selectedId,
                        hasAnsweredCurrent
                    };
                    localStorage.setItem(PROGRESS_KEY, JSON.stringify(stateToSave));
                } else if (view === 'menu' || view === 'result') {
                    localStorage.removeItem(PROGRESS_KEY);
                }
            }, [view, currentBlockTitle, questionsQueue, failedQueue, currentIndex, stats, isReviewing, selectedId, hasAnsweredCurrent]);

            // Derivaci├│n din├ímica de los bloques del men├║ principal
            const blocksList = useMemo(() => {
                const blocksMap = {};
                allQuestions.forEach(q => {
                    if (!blocksMap[q.block_id]) {
                        blocksMap[q.block_id] = {
                            id: q.block_id,
                            title: q.block_title,
                            subtitle: q.block_subtitle,
                            exam: q.exam_name,
                            count: 0
                        };
                    }
                    blocksMap[q.block_id].count++;
                });
                return Object.values(blocksMap).sort((a, b) => a.id - b.id);
            }, []);

            // Pregunta activa en la cola de cuestionario
            const currentQuestion = useMemo(() => {
                if (questionsQueue.length === 0 || currentIndex >= questionsQueue.length) return null;
                return questionsQueue[currentIndex];
            }, [questionsQueue, currentIndex]);

            // Barajado s├¡ncrono de opciones mediante useMemo para evitar re-barajados destructivos
            const shuffledOptions = useMemo(() => {
                if (!currentQuestion) return [];
                const mapped = currentQuestion.options.map((optText, idx) => ({
                    id: idx, // Identificador original
                    text: optText,
                    isCorrect: idx === currentQuestion.correct
                }));
                return shuffleArray(mapped);
            }, [currentQuestion, currentIndex]);

            // Manejo de inicio de test para un bloque espec├¡fico
            const handleStartBlock = (blockId) => {
                const blockQuestions = allQuestions.filter(q => q.block_id === blockId);
                const shuffled = shuffleArray(blockQuestions);
                const blockInfo = blocksList.find(b => b.id === blockId);
                
                // Reseteo de estados de forma s├¡ncrona
                setQuestionsQueue(shuffled);
                setFailedQueue([]);
                setCurrentIndex(0);
                setIsReviewing(false);
                setStats({ answered: 0, correct: 0, failed: 0 });
                setCurrentBlockTitle(`${blockInfo.title} - ${blockInfo.subtitle}`);
                setSelectedId(null);
                setHasAnsweredCurrent(false);
                setView('quiz');
            };

            // Iniciar simulacro global (todas las preguntas de la base de datos)
            const handleStartMockExam = () => {
                const shuffled = shuffleArray(allQuestions);
                setQuestionsQueue(shuffled);
                setFailedQueue([]);
                setCurrentIndex(0);
                setIsReviewing(false);
                setStats({ answered: 0, correct: 0, failed: 0 });
                setCurrentBlockTitle("Simulacro General - Todas las preguntas jur├¡dicas y de gesti├│n");
                setSelectedId(null);
                setHasAnsweredCurrent(false);
                setView('quiz');
            };

            // Manejo de la selecci├│n de una opci├│n por parte del usuario
            const handleOptionClick = (optionId) => {
                if (hasAnsweredCurrent) return;
                
                setSelectedId(optionId);
                setHasAnsweredCurrent(true);
                
                const isCorrect = optionId === currentQuestion.correct;
                
                // Actualizaci├│n inmutable del contador de estad├¡sticas
                setStats(prev => ({
                    ...prev,
                    answered: prev.answered + 1,
                    correct: isCorrect ? prev.correct + 1 : prev.correct,
                    failed: !isCorrect ? prev.failed + 1 : prev.failed
                }));

                // Si es incorrecta, se a├▒ade a la cola de fallos sin duplicados
                if (!isCorrect) {
                    setFailedQueue(prev => {
                        if (prev.some(q => q.id === currentQuestion.id)) return prev;
                        return [...prev, currentQuestion];
                    });
                }
            };

            // Avance a la siguiente pregunta o gesti├│n del bucle recursivo de repaso
            const handleNext = () => {
                setSelectedId(null);
                setHasAnsweredCurrent(false);

                if (currentIndex + 1 < questionsQueue.length) {
                    setCurrentIndex(currentIndex + 1);
                } else {
                    // Fin de la ronda actual
                    if (failedQueue.length > 0) {
                        // Se carga la cola de fallos barajada y se reinicia el ├¡ndice
                        setQuestionsQueue(shuffleArray(failedQueue));
                        setFailedQueue([]);
                        setCurrentIndex(0);
                        setIsReviewing(true);
                    } else {
                        // Bloque completado satisfactoriamente (0 fallos restantes)
                        setView('result');
                    }
                }
            };

            // Retorno directo al men├║ principal limpiando el estado persistido
            const handleReturnToMenu = () => {
                if (confirm("┬┐Est├ís seguro de que deseas salir? Perder├ís el progreso del test actual.")) {
                    setView('menu');
                }
            };

            // Progreso en porcentaje para la barra de visualizaci├│n
            const progressPct = useMemo(() => {
                if (questionsQueue.length === 0) return 0;
                return (currentIndex / questionsQueue.length) * 100;
            }, [questionsQueue, currentIndex]);

            return (
                <div className="min-h-screen flex flex-col justify-between">
                    {/* Encabezado Principal */}
                    <header className="border-b border-slate-850 bg-slate-900/80 backdrop-blur-md sticky top-0 z-50">
                        <div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
                            <div className="flex items-center space-x-3 cursor-pointer" onClick={() => { if (view !== 'menu') handleReturnToMenu(); }} >
                                <div className="bg-indigo-600 text-white p-2.5 rounded-xl shadow-lg shadow-indigo-600/30 flex items-center justify-center">
                                    <i className="fa-solid fa-scale-balanced text-lg"></i>
                                </div>
                                <div>
                                    <h1 className="font-bold text-lg text-white leading-tight">OPE Cuerpo Administrativo</h1>
                                    <p className="text-xs text-indigo-400 font-medium">Temario Jur├¡dico y de Gesti├│n &bull; IVAP</p>
                                </div>
                            </div>

                            {/* Bot├│n de salida si estamos en el test */}
                            {view === 'quiz' && (
                                <button 
                                    onClick={handleReturnToMenu}
                                    className="px-3.5 py-1.5 rounded-lg text-sm font-medium text-slate-300 bg-slate-800 hover:bg-slate-700 hover:text-white transition-all duration-200 border border-slate-700 flex items-center space-x-2"
                                >
                                    <i className="fa-solid fa-arrow-left text-xs"></i>
                                    <span>Men├║ Principal</span>
                                </button>
                            )}
                        </div>
                    </header>

                    {/* VISTA 1: MEN├Ü PRINCIPAL */}
                    {view === 'menu' && (
                        <main className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 flex-1 animate-fade-in w-full">
                            {/* Banner Informativo */}
                            <div className="glass-card rounded-2xl p-6 sm:p-8 mb-8 relative overflow-hidden border border-indigo-500/20">
                                <div className="absolute -right-10 -bottom-10 w-64 h-64 bg-indigo-500/10 rounded-full blur-3xl pointer-events-none"></div>
                                <div className="relative z-10">
                                    <div className="flex flex-col md:flex-row md:items-center justify-between gap-6">
                                        <div>
                                            <span className="bg-indigo-500/20 text-indigo-300 px-3 py-1 rounded-full text-xs font-semibold tracking-wider uppercase">Simulador de Oposiciones</span>
                                            <h2 className="text-2xl md:text-3xl font-extrabold text-white mt-2">Cuerpo Administrativo - Temario Com├║n</h2>
                                            <p className="text-slate-300 mt-2 max-w-2xl text-sm md:text-base leading-relaxed">
                                                Cuestionarios oficiales de bolsas de trabajo y oposiciones (2008, 2010 y 2017) depurados. Se han excluido las preguntas de inform├ítica, ofim├ítica y las anuladas por el tribunal para focalizar el estudio en la legislaci├│n y organizaci├│n p├║blica.
                                            </p>
                                        </div>
                                        <div>
                                            <button 
                                                onClick={handleStartMockExam}
                                                className="w-full md:w-auto px-6 py-3.5 bg-gradient-to-r from-indigo-600 to-violet-600 text-white rounded-xl font-semibold shadow-lg shadow-indigo-600/25 hover:from-indigo-500 hover:to-violet-500 transition-all duration-200 flex items-center justify-center space-x-2 text-sm"
                                            >
                                                <i className="fa-solid fa-graduation-cap"></i>
                                                <span>Simulacro General (292 Qs)</span>
                                            </button>
                                        </div>
                                    </div>
                                    
                                    {/* Estad├¡sticas de la base de datos */}
                                    <div className="grid grid-cols-2 sm:grid-cols-4 gap-4 mt-6 pt-6 border-t border-slate-700/50">
                                        <div className="text-center sm:text-left">
                                            <p className="text-xs text-slate-400 uppercase font-bold tracking-wider">Preguntas Totales</p>
                                            <p className="text-xl font-bold text-slate-100 mt-1">292</p>
                                        </div>
                                        <div className="text-center sm:text-left">
                                            <p className="text-xs text-slate-400 uppercase font-bold tracking-wider">Ex├ímenes Reales</p>
                                            <p className="text-xl font-bold text-slate-100 mt-1">3 Ediciones</p>
                                        </div>
                                        <div className="text-center sm:text-left">
                                            <p className="text-xs text-slate-400 uppercase font-bold tracking-wider">Temario Filtro</p>
                                            <p className="text-xl font-bold text-slate-100 mt-1">Jur├¡dico y Gesti├│n</p>
                                        </div>
                                        <div className="text-center sm:text-left">
                                            <p className="text-xs text-slate-400 uppercase font-bold tracking-wider">Modo Repaso</p>
                                            <p className="text-xl font-bold text-slate-100 mt-1">Bucle sin fin</p>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            {/* Grid de Bloques */}
                            <h3 className="text-lg font-bold text-white mb-6 flex items-center space-x-2">
                                <i className="fa-solid fa-list-check text-indigo-400"></i>
                                <span>Bloques de Estudio</span>
                            </h3>
                            
                            <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                                {blocksList.map(block => (
                                    <div 
                                        key={block.id}
                                        className="glass-card glass-card-hover rounded-xl p-5 flex flex-col justify-between h-52 cursor-pointer border border-slate-800"
                                        onClick={() => handleStartBlock(block.id)}
                                    >
                                        <div>
                                            <div className="flex justify-between items-start">
                                                <span className="bg-indigo-500/10 text-indigo-300 text-xs font-semibold px-2.5 py-1 rounded-md border border-indigo-500/20">
                                                    {block.title}
                                                </span>
                                                <span className="text-xs text-slate-400 flex items-center space-x-1">
                                                    <i className="fa-solid fa-circle-question"></i>
                                                    <span>{block.count} preguntas</span>
                                                </span>
                                            </div>
                                            <h4 className="text-base font-bold text-white mt-3 line-clamp-2 leading-snug">
                                                {block.subtitle}
                                            </h4>
                                            <p className="text-xs text-slate-400 mt-2 line-clamp-1">
                                                {block.exam}
                                            </p>
                                        </div>
                                        <div className="mt-4 pt-4 border-t border-slate-800/80 flex items-center justify-between text-indigo-400 text-sm font-semibold">
                                            <span>Comenzar test</span>
                                            <i className="fa-solid fa-arrow-right"></i>
                                        </div>
                                    </div>
                                ))}
                            </div>
                        </main>
                    )}

                    {/* VISTA 2: CUESTIONARIO */}
                    {view === 'quiz' && currentQuestion && (
                        <main className="max-w-4xl mx-auto px-4 py-8 flex-1 animate-fade-in w-full">
                            {/* Cabecera del Test */}
                            <div className="glass-card rounded-xl p-4 mb-6 border border-slate-800">
                                <div className="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
                                    <div>
                                        <h4 className="text-xs text-indigo-400 font-bold uppercase tracking-wider">
                                            {isReviewing ? "≡ƒöä Rda de Repaso (Fallos)" : "≡ƒô¥ Cuestionario Activo"}
                                        </h4>
                                        <h3 className="text-sm font-bold text-white mt-0.5 line-clamp-1">
                                            {currentBlockTitle}
                                        </h3>
                                    </div>
                                    {/* Contadores Estad├¡sticos */}
                                    <div className="flex items-center space-x-4 self-end sm:self-auto">
                                        <div className="flex items-center space-x-1.5 bg-emerald-500/10 text-emerald-400 px-3 py-1.5 rounded-lg border border-emerald-500/20 text-xs font-bold">
                                            <i className="fa-regular fa-circle-check"></i>
                                            <span>Aciertos: {stats.correct}</span>
                                        </div>
                                        <div className="flex items-center space-x-1.5 bg-rose-500/10 text-rose-400 px-3 py-1.5 rounded-lg border border-rose-500/20 text-xs font-bold">
                                            <i className="fa-regular fa-circle-xmark"></i>
                                            <span>Fallos: {stats.failed}</span>
                                        </div>
                                    </div>
                                </div>

                                {/* Barra de Progreso */}
                                <div className="mt-4">
                                    <div className="flex justify-between text-xs text-slate-400 mb-1.5 font-medium">
                                        <span>Pregunta {currentIndex + 1} de {questionsQueue.length}</span>
                                        <span>{Math.round(progressPct)}% completado</span>
                                    </div>
                                    <div className="w-full bg-slate-950 h-2 rounded-full overflow-hidden border border-slate-800">
                                        <div 
                                            className="bg-indigo-500 h-full transition-all duration-300 rounded-full"
                                            style={{ width: `${progressPct}%` }}
                                        ></div>
                                    </div>
                                </div>
                            </div>

                            {/* Enunciado de la Pregunta */}
                            <div className="glass-card rounded-2xl p-6 sm:p-8 mb-6 border border-slate-800 relative">
                                <span className="absolute -left-3 top-6 bg-indigo-600 text-white w-9 h-9 rounded-xl flex items-center justify-center font-extrabold text-sm shadow-md">
                                    {currentQuestion.num}
                                </span>
                                <div className="pl-4">
                                    <p className="text-xs text-slate-400 font-bold uppercase tracking-wider mb-1">
                                        {currentQuestion.exam_name}
                                    </p>
                                    <h3 className="text-lg font-bold text-white leading-relaxed">
                                        {currentQuestion.text}
                                    </h3>
                                </div>
                            </div>

                            {/* Lista de Opciones */}
                            <div className="space-y-4 mb-6">
                                {shuffledOptions.map((opt, idx) => {
                                    const optLetters = ["A", "B", "C", "D"];
                                    
                                    // Determinaci├│n de clases de estilo para las opciones seg├║n el estado de respuesta
                                    let btnClass = "border-slate-800 bg-slate-800/40 text-slate-200 hover:bg-slate-800/80 hover:border-slate-700";
                                    let iconClass = "bg-slate-700/50 text-slate-400 group-hover:bg-slate-600/50";
                                    
                                    if (hasAnsweredCurrent) {
                                        if (opt.isCorrect) {
                                            // Correcta siempre en verde
                                            btnClass = "border-emerald-500/50 bg-emerald-500/10 text-emerald-200 shadow-md";
                                            iconClass = "bg-emerald-600 text-white";
                                        } else if (opt.id === selectedId) {
                                            // Incorrecta seleccionada en rojo
                                            btnClass = "border-rose-500/50 bg-rose-500/10 text-rose-200 shadow-md";
                                            iconClass = "bg-rose-600 text-white";
                                        } else {
                                            // Resto de opciones desvanecidas
                                            btnClass = "border-slate-900/50 bg-slate-900/30 text-slate-500 opacity-60";
                                            iconClass = "bg-slate-800 text-slate-600";
                                        }
                                    }

                                    return (
                                        <button
                                            key={opt.id}
                                            disabled={hasAnsweredCurrent}
                                            onClick={() => handleOptionClick(opt.id)}
                                            className={`w-full p-4 rounded-xl text-left border flex items-start space-x-4 transition-all duration-200 group ${btnClass}`}
                                        >
                                            <span className={`w-7 h-7 rounded-lg flex items-center justify-center font-bold text-sm shrink-0 ${iconClass}`}>
                                                {hasAnsweredCurrent && opt.isCorrect ? (
                                                    <i className="fa-solid fa-check text-xs"></i>
                                                ) : hasAnsweredCurrent && opt.id === selectedId ? (
                                                    <i className="fa-solid fa-xmark text-xs"></i>
                                                ) : (
                                                    optLetters[idx]
                                                )}
                                            </span>
                                            <span className="text-sm font-medium leading-relaxed pt-0.5">
                                                {opt.text}
                                            </span>
                                        </button>
                                    );
                                })}
                            </div>

                            {/* Bot├│n de Siguiente Pregunta */}
                            {hasAnsweredCurrent && (
                                <div className="flex justify-end animate-fade-in">
                                    <button 
                                        onClick={handleNext}
                                        className="px-6 py-3 bg-indigo-600 hover:bg-indigo-500 text-white rounded-xl font-semibold shadow-lg shadow-indigo-600/25 transition-all duration-200 flex items-center space-x-2 text-sm"
                                    >
                                        <span>
                                            {currentIndex + 1 === questionsQueue.length 
                                                ? (failedQueue.length > 0 ? "Comenzar Ronda de Repaso" : "Ver Resultados") 
                                                : "Siguiente Pregunta"}
                                        </span>
                                        <i className="fa-solid fa-arrow-right-long text-xs"></i>
                                    </button>
                                </div>
                            )}
                        </main>
                    )}

                    {/* VISTA 3: RESULTADOS */}
                    {view === 'result' && (
                        <main className="max-w-xl mx-auto px-4 py-12 flex-1 animate-fade-in w-full">
                            <div className="glass-card rounded-2xl p-8 border border-slate-800 text-center relative overflow-hidden">
                                <div className="absolute -right-16 -top-16 w-48 h-48 bg-indigo-500/10 rounded-full blur-2xl pointer-events-none"></div>
                                <div className="absolute -left-16 -bottom-16 w-48 h-48 bg-emerald-500/10 rounded-full blur-2xl pointer-events-none"></div>
                                
                                <div className="relative z-10">
                                    <div className="w-16 h-16 bg-emerald-500/20 text-emerald-400 rounded-full flex items-center justify-center mx-auto mb-6 shadow-lg">
                                        <i className="fa-solid fa-circle-check text-3xl animate-bounce"></i>
                                    </div>
                                    
                                    <h2 className="text-2xl font-extrabold text-white mb-2">┬íBloque Completado!</h2>
                                    <p className="text-sm text-slate-300 max-w-md mx-auto mb-8 leading-relaxed">
                                        ┬íExcelente trabajo! Has respondido de manera correcta a todas las preguntas de la sesi├│n activa, resolviendo tus errores mediante el bucle recursivo de repaso.
                                    </p>
                                    
                                    {/* M├⌐tricas Finales */}
                                    <div className="grid grid-cols-3 gap-4 mb-8">
                                        <div className="bg-slate-800/50 p-4 rounded-xl border border-slate-700/50">
                                            <p className="text-xs text-slate-400 uppercase font-bold tracking-wider">Intentos</p>
                                            <p className="text-xl font-extrabold text-white mt-1">{stats.answered}</p>
                                        </div>
                                        <div className="bg-slate-800/50 p-4 rounded-xl border border-slate-700/50">
                                            <p className="text-xs text-slate-400 uppercase font-bold tracking-wider">Aciertos</p>
                                            <p className="text-xl font-extrabold text-emerald-400 mt-1">{stats.correct}</p>
                                        </div>
                                        <div className="bg-slate-800/50 p-4 rounded-xl border border-slate-700/50">
                                            <p className="text-xs text-slate-400 uppercase font-bold tracking-wider">Fallos</p>
                                            <p className="text-xl font-extrabold text-rose-400 mt-1">{stats.failed}</p>
                                        </div>
                                    </div>
                                    
                                    <button 
                                        onClick={() => setView('menu')}
                                        className="w-full py-3.5 bg-gradient-to-r from-indigo-600 to-violet-600 hover:from-indigo-500 hover:to-violet-500 text-white rounded-xl font-semibold shadow-lg shadow-indigo-600/25 transition-all duration-200 flex items-center justify-center space-x-2 text-sm"
                                    >
                                        <i className="fa-solid fa-house"></i>
                                        <span>Volver al Men├║ Principal</span>
                                    </button>
                                </div>
                            </div>
                        </main>
                    )}

                    {/* Pie de p├ígina */}
                    <footer className="border-t border-slate-800/80 bg-slate-950/60 py-4 text-center text-xs text-slate-500 mt-auto">
                        <div className="max-w-7xl mx-auto px-4">
                            Simulador Interactivo SPA &bull; Bolsa de Trabajo y Oposiciones Cuerpo Administrativo (IVAP)
                        </div>
